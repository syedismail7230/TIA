# ===================================================
# THE INFLUENCER'S AGENCY (TIA) - ENVIRONMENT VARIABLES
# ===================================================

# Server & Application
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=tia_production_grade_jwt_secret_key_minimum_32_characters_long_entropy_secure_2026

# Database & Backend Infrastructure
# Local SQLite for deterministic local verification: "file:./dev.db"
# Production PostgreSQL / Supabase: "postgresql://postgres:password@localhost:5432/tia_db?schema=public"
DATABASE_URL="file:./dev.db"

# Supabase (Auth, Storage & Database Services)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=

# Platform Commercial Rules (Configurable Layer)
PLATFORM_COMMISSION_RATE=5.00

# Social Platform OAuth Connectors (Provide credentials to connect to live platform APIs)
# Meta (Instagram & Facebook Graph API)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/connectors/instagram/callback

# Google / YouTube Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/connectors/youtube/callback

# LinkedIn Marketing Developer API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/connectors/linkedin/callback

# X (Twitter) API v2 Developer Portal
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/connectors/x/callback

# Payment Gateway Infrastructure
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storage & File Uploads (S3 / R2 / GCS / Local fallback)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# AI Profile Studio & Face Identity
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
REPLICATE_API_TOKEN=
